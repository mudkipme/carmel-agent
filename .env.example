# Copy to .env for development or Compose. Keep real values out of Git.
# Set these to the output of id -u and id -g for Compose.
CARMEL_HOST_UID=1000
CARMEL_HOST_GID=1000
# Generate once with openssl rand -hex 32. Preserve this key with your backups.
# Compose and production startup refuse an empty key.
CARMEL_SECRET_KEY=

# Optional: pin both images to the same release tag or commit SHA.
# CARMEL_IMAGE=ghcr.io/mudkipme/carmel-agent:latest
# CARMEL_BASH_IMAGE=ghcr.io/mudkipme/carmel-agent-runner:latest
# Knowledge uses the runner image with separate resource limits (see docs/knowledge.md).
# Global embedding model: an hf: URI or an absolute GGUF file accessible to the server.
# CARMEL_KNOWLEDGE_EMBED_MODEL=hf:ggml-org/embeddinggemma-300M-GGUF/embeddinggemma-300M-Q8_0.gguf
# CARMEL_KNOWLEDGE_IMAGE=ghcr.io/mudkipme/carmel-agent-runner:latest
# CARMEL_KNOWLEDGE_MEMORY_MB=4096
# CARMEL_KNOWLEDGE_CPUS=2
# Inherits CARMEL_BASH_GPU unless set; an empty value disables knowledge GPU passthrough.
# CARMEL_KNOWLEDGE_GPU=nvidia.com/gpu=all

# Rootful Docker (rootless Podman is the default):
# CARMEL_USERNS_MODE=host
# CARMEL_RUNTIME_SOCKET=/var/run/docker.sock
# CARMEL_SOCKET_GID=1000
