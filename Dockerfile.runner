# Runner image: the per-agent bash sandbox container that carmel-agent starts on
# demand when an agent has the bash permission. This is what CARMEL_BASH_IMAGE
# points at. Carmel mounts the agent workspace at /workspace and overrides the
# entrypoint, so the toolchain here is what agents can use from bash.
#
# Build: podman build -f Dockerfile.runner -t carmel-agent-runner:latest .
# Use:   CARMEL_BASH_IMAGE=localhost/carmel-agent-runner:latest
FROM node:24-trixie-slim

ENV AGENT_BROWSER_CONFIG="/etc/agent-browser/config.json"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      chromium \
      curl \
      fonts-freefont-ttf \
      fonts-noto \
      fonts-noto-cjk \
      fonts-noto-color-emoji \
      git \
      libegl1 \
      libvulkan1 \
      python3 \
      python3-pip \
      ripgrep \
      wget && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/bin/python3 /usr/local/bin/python

# qmd runs llama.cpp on the GPU through Vulkan when CARMEL_BASH_GPU exposes one.
# The NVIDIA container toolkit injects the driver (libGLX_nvidia, the Vulkan ICD
# manifest, /dev/nvidia*) but never the vendor-neutral GLVND/loader libraries --
# those must come from the image. libvulkan1 is the Vulkan loader; libegl1 pulls
# in libEGL.so.1, which libGLX_nvidia dlopens during ICD init. Without libegl1
# that init fails, vk_icdGetInstanceProcAddr returns NULL for vkCreateInstance,
# and qmd silently falls back to CPU even though nvidia-smi sees the GPU.

# agent-browser drives the bundled Chromium. The browser profile is tool state,
# so it lives in the agent's private $HOME; downloads stay under /workspace where
# the user can see them as project files. Both are bind-mounted per agent.
RUN mkdir -p /etc/agent-browser && \
    printf '%s\n' \
      '{' \
      '  "$schema": "https://agent-browser.dev/schema.json",' \
      '  "executablePath": "/usr/bin/chromium",' \
      '  "args": "--no-sandbox,--disable-dev-shm-usage,--disable-gpu",' \
      '  "ignoreHttpsErrors": true,' \
      '  "downloadPath": "/workspace/.agent-browser/downloads",' \
      '  "profile": "/home/agent/.agent-browser/profile"' \
      '}' \
      > /etc/agent-browser/config.json

RUN npm install -g agent-browser@0.27.0 @tobilu/qmd && \
    agent-browser --version && \
    qmd --version

# Everything below must stay after the global installs above: it repoints npm's
# global prefix into $HOME, which carmel bind-mounts per agent. Without it
# `npm install -g` writes to /usr/local inside the container layer and is lost
# the next time the runner is recreated (idle reap, config change, restart).
#
# The PATH additions go in /etc/profile.d rather than the exec environment
# because carmel runs commands via `bash -lc`, and Debian's /etc/profile
# reassigns PATH unconditionally -- anything we pass in as PATH is discarded.
RUN mkdir -p /home/agent/.npm-global/bin /home/agent/.local/bin /usr/local/etc && \
    printf 'prefix=/home/agent/.npm-global\n' > /usr/local/etc/npmrc && \
    printf '%s\n' \
      'export PATH="$HOME/.npm-global/bin:$HOME/.local/bin:$PATH"' \
      > /etc/profile.d/carmel-home.sh

ENV HOME="/home/agent"

WORKDIR /workspace

# Overridden by carmel-agent (it runs the container as a long-lived sandbox);
# this default just keeps the container alive for manual use.
CMD ["sleep", "infinity"]
