{
  "name": "carmel-agent",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm --filter @carmel-agent/server dev\" \"pnpm --filter @carmel-agent/client dev\"",
    "dev:client": "pnpm --filter @carmel-agent/client dev",
    "dev:server": "pnpm --filter @carmel-agent/server dev",
    "server": "pnpm --filter @carmel-agent/server start",
    "serve": "pnpm --filter @carmel-agent/server start",
    "build": "pnpm -r build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "pnpm --filter @carmel-agent/server test && pnpm --filter @carmel-agent/client test",
    "test:browser": "pnpm --filter @carmel-agent/client test:browser",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "preview": "pnpm --filter @carmel-agent/client preview"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.20.0"
}
