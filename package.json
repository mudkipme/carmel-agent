{
  "name": "carmel-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm --filter @carmel-agent/server dev\" \"pnpm --filter @carmel-agent/client dev\"",
    "dev:client": "pnpm --filter @carmel-agent/client dev",
    "dev:server": "pnpm --filter @carmel-agent/server dev",
    "server": "pnpm --filter @carmel-agent/server start",
    "serve": "pnpm --filter @carmel-agent/server start",
    "build": "pnpm -r build",
    "lint": "oxlint .",
    "test": "pnpm --filter @carmel-agent/server test",
    "check": "pnpm lint && pnpm test && pnpm build",
    "preview": "pnpm --filter @carmel-agent/client preview"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "oxlint": "^1.68.0",
    "shadcn": "^4.7.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.1.2"
}
