  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "DATABASE_URL=:memory: node --import tsx --test src/*.test.ts src/*/*.test.ts src/*/*/*.test.ts",
    "fixtures:capture": "node --import tsx scripts/capture-run-fixture.ts",
    "fixtures:provider": "node --import tsx scripts/fake-ollama.ts",
    "test:browser-sandbox": "node --import tsx scripts/test-browser-sandbox.ts",
    "test:sandbox-identity": "node --import tsx scripts/test-sandbox-identity.ts",
    "test:knowledge-sandbox": "node --import tsx scripts/test-knowledge-sandbox.ts",
    "test:knowledge-shell-sandbox": "node --import tsx scripts/test-knowledge-shell-sandbox.ts",
    "user:create": "tsx src/cli/create-user.ts"
  },
  "dependencies": {
    "@carmel-agent/shared": "workspace:*",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-mcp": "1.4.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "better-sqlite3": "^13.0.3",
    "cron-parser": "^5.10.2",
    "defuddle": "^0.19.5",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "linkedom": "^0.18.14",
    "openid-client": "^6.8.8",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2"
  }
