{
  "name": "@carmel-agent/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "DATABASE_URL=:memory: node --import tsx --test src/*.test.ts src/*/*.test.ts src/*/*/*.test.ts",
    "fixtures:capture": "node --import tsx scripts/capture-run-fixture.ts",
    "fixtures:provider": "node --import tsx scripts/fake-ollama.ts",
    "test:browser-sandbox": "node --import tsx scripts/test-browser-sandbox.ts",
    "test:sandbox-identity": "node --import tsx scripts/test-sandbox-identity.ts",
    "user:create": "tsx src/cli/create-user.ts"
  },
  "dependencies": {
    "@carmel-agent/shared": "workspace:*",
    "@earendil-works/pi-agent-core": "^0.99.1",
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-codemode": "^0.99.1",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-mcp": "^0.99.1",
    "@earendil-works/pi-session-backend-sqlite-node": "^0.99.1",
    "@hono/node-server": "^2.0.3",
    "@hono/zod-validator": "^0.8.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.0",
    "defuddle": "^0.19.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "linkedom": "^0.18.13",
    "openid-client": "^6.8.8",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "ajv": "^8.17.1",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2",
    "yaml": "^2.8.1"
  }
}
