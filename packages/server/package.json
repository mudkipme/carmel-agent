{
  "name": "@carmel-agent/server",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "DATABASE_URL=:memory: node --import tsx --test src/*.test.ts src/*/*.test.ts src/*/*/*.test.ts",
    "fixtures:capture": "node --import tsx scripts/capture-run-fixture.ts",
    "fixtures:provider": "node --import tsx scripts/fake-ollama.ts",
    "test:browser-sandbox": "node --import tsx scripts/test-browser-sandbox.ts",
    "test:sandbox-identity": "node --import tsx scripts/test-sandbox-identity.ts",
    "test:knowledge-sandbox": "node --import tsx scripts/test-knowledge-sandbox.ts",
    "test:knowledge-shell-sandbox": "node --import tsx scripts/test-knowledge-shell-sandbox.ts",
    "user:create": "tsx src/cli/create-user.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/cli/migrate.ts",
    "openapi": "DATABASE_URL=:memory: node --import tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@carmel-agent/shared": "workspace:*",
    "@earendil-works/chord": "catalog:",
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-codemode": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-durable": "catalog:",
    "@earendil-works/pi-mcp": "catalog:",
    "@earendil-works/pi-schema": "catalog:",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "better-sqlite3": "^13.2.0",
    "cron-parser": "^5.10.6",
    "defuddle": "^0.19.6",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "linkedom": "^0.18.15",
    "openid-client": "^6.9.0",
    "qrcode": "^1.5.4",
    "tsx": "catalog:",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:"
  }
}
